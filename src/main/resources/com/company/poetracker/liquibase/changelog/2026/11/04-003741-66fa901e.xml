        <addForeignKeyConstraint baseColumnNames="USER_ID" baseTableName="POE_CHARACTER"
                                 constraintName="FK_POE_CHARACTER_ON_USER" referencedColumnNames="ID"
                                 referencedTableName="USER_"/>
    </changeSet>
    <changeSet id="3" author="poetracker">
        <dropColumn columnName="OWNER_ID" tableName="POE_CHARACTER"/>
    </changeSet>
</databaseChangeLog>
