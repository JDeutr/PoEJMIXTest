<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://itemListView.title"
      focusComponent="itemsDataGrid">
    <data>
        <collection id="itemsDc"
                    class="com.company.poetracker.entity.Item">
            <fetchPlan extends="_base">
                <property name="owner" fetchPlan="_base">
                    <property name="user" fetchPlan="_base"/>
                    <property name="league" fetchPlan="_base"/>
                </property>
            </fetchPlan>
            <loader id="itemsDl" readOnly="true">
                <query>
                    <![CDATA[select e from Item e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="itemsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="itemsDataGrid.createAction"/>
                <button id="editButton" action="itemsDataGrid.editAction"/>
                <button id="removeButton" action="itemsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="itemsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="itemsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="itemsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="name"/>
                <column property="baseType"/>
                <column property="rarity"/>
                <column property="owner"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
